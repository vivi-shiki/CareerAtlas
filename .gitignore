# Machine-specific documentation, environment state, and private research.
/.local/

# Runtime configuration; only sanitized examples belong in Git.
.env
.env.*
!.env.example
!.env.*.example

# Credential material must never be committed.
/credentials/
/secrets/
*.pem
*.key

# Installed dependencies and generated application output.
/vendor/
/node_modules/
/public/build/
/public/docs/
/docs/.vitepress/cache/
/public/hot
/storage/*.key
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*.php
/.phpunit.cache/
/.phpunit.result.cache
/playwright-report/
/test-results/
/deploy/__pycache__/
